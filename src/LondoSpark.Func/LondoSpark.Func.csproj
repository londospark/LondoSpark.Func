<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Version>0.4.0-prealpha.1</Version>
    <PackageId>LondoSpark.Func</PackageId>
    <AssemblyName>LondoSpark.Func</AssemblyName>
    <RootNamespace>LondoSpark.Func</RootNamespace>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <Authors>LondoSpark</Authors>
    <Description>Small functional primitives for explicit absence and expected failure in C#.</Description>
    <PackageTags>functional;option;result;fsharp</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/londospark/LondoSpark.Func</RepositoryUrl>
    <PackageProjectUrl>https://github.com/londospark/LondoSpark.Func</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);PackAnalyzer</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../LondoSpark.Func.Analyzers/LondoSpark.Func.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
    <ProjectReference Include="../LondoSpark.Func.CodeFixes/LondoSpark.Func.CodeFixes.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
    <ProjectReference Include="../LondoSpark.Func.Generators/LondoSpark.Func.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="buildTransitive/LondoSpark.Func.props" Pack="true" PackagePath="buildTransitive/" />
    <None Include="buildTransitive/LondoSpark.Func.targets" Pack="true" PackagePath="buildTransitive/" />
  </ItemGroup>

  <Target Name="PackAnalyzer">
    <MSBuild Projects="../LondoSpark.Func.Analyzers/LondoSpark.Func.Analyzers.csproj;../LondoSpark.Func.CodeFixes/LondoSpark.Func.CodeFixes.csproj;../LondoSpark.Func.Generators/LondoSpark.Func.Generators.csproj"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_AnalyzerAssembly" />
    </MSBuild>
    <ItemGroup>
      <TfmSpecificPackageFile Include="@(_AnalyzerAssembly)" PackagePath="analyzers/dotnet/cs" />
    </ItemGroup>
  </Target>

</Project>
