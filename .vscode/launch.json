{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "BenchmarkDotNet (in-process)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build benchmarks",
      "program": "${workspaceFolder}/benchmarks/LondoSpark.Func.Benchmarks/bin/Release/net11.0/LondoSpark.Func.Benchmarks.dll",
      "args": [
        "--inProcess"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false,
      "justMyCode": false
    }
  ]
}
